PORT=3000
NODE_ENV=development
# Database
DATABASE_PATH=./database.db
UPLOAD_DIR=./uploads
MAX_PHOTOS_PER_CAT=7
PHOTO_RETENTION_DAYS=30

# Database Options
# RESET_DB=true          # Clean slate - removes all data and recreates tables
# MIGRATE_DB=true        # Preserve data - updates schema while keeping existing data

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
